{
  "schemaVersion": "1.0",
  "application": "klyrow.com",
  "status": "ALIAS_MANIFEST_ONLY",
  "authority": "Codestra-OpenBao",
  "gitMayContainSecretValues": false,
  "aliases": [
    {
      "name": "klyrow/middleware/client-secret",
      "usedBy": "gateway",
      "mountedAs": "KLYROW_MIDDLEWARE_CLIENT_SECRET_FILE",
      "requiredBefore": "staging middleware canary"
    },
    {
      "name": "klyrow/middleware/hmac-secret",
      "usedBy": "gateway",
      "mountedAs": "KLYROW_WEBHOOK_SECRET_FILE",
      "requiredBefore": "signed delivery events"
    },
    {
      "name": "klyrow/postal/api-key",
      "usedBy": "gateway",
      "mountedAs": "KLYROW_POSTAL_API_KEY_FILE",
      "requiredBefore": "SMTP provider command execution"
    },
    {
      "name": "klyrow/smtp/tls-cert",
      "usedBy": "postal-smtp",
      "mountedAs": "KLYROW_SMTP_TLS_CERT",
      "requiredBefore": "public SMTP STARTTLS"
    },
    {
      "name": "klyrow/smtp/tls-key",
      "usedBy": "postal-smtp",
      "mountedAs": "KLYROW_SMTP_TLS_KEY",
      "requiredBefore": "public SMTP STARTTLS"
    },
    {
      "name": "klyrow/n8n/credential-reference",
      "usedBy": "n8n",
      "mountedAs": "n8n credential store item",
      "requiredBefore": "workflow import"
    }
  ],
  "forbiddenInGit": [
    "client_secret",
    "access_token",
    "refresh_token",
    "api_key",
    "smtp_password",
    "smtp_tls_key",
    "postal_api_key",
    "webhook_secret",
    "middleware_api_key"
  ]
}

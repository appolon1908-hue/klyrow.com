KLYROW_ENV=production
KLYROW_PUBLIC_URL=https://app.klyrow.com
KLYROW_API_URL=https://api.klyrow.com
KLYROW_DATABASE_URL=postgresql+psycopg://klyrow:CHANGE_ME@postgres:5432/klyrow
KLYROW_SESSION_SECRET_FILE=secrets/runtime/session-secret
KLYROW_POSTAL_API_KEY_FILE=secrets/runtime/postal-api-key
KLYROW_POSTAL_TRANSPORTS_HOST_FILE=/etc/klyrow/postal-transports.json
KLYROW_POSTAL_CREDENTIALS_DIR=/etc/klyrow/postal-credentials
KLYROW_POSTAL_TRANSPORTS_FILE=/run/klyrow/postal-transports.json
KLYROW_SEED_SECRETS_DIR=/etc/klyrow/seed-secrets
KLYROW_SEED_SECRET_DIR=/run/klyrow/seed-secrets
KLYROW_METRICS_TOKEN_FILE=secrets/runtime/metrics-token
KLYROW_ADMIN_EMAIL=admin@klyrow.com
KLYROW_ADMIN_PASSWORD=CHANGE_ME_20_CHARS
KLYROW_MIDDLEWARE_URL=http://10.40.0.1:8095
KLYROW_MIDDLEWARE_API_KEY=CHANGE_ME_64_HEX
KLYROW_WEBHOOK_SECRET=CHANGE_ME_64_HEX
KLYROW_SAFE_MODE=true
LIVE_SMS_DELIVERY=false
LIVE_EMAIL_DELIVERY=false
EXTERNAL_SMS_DELIVERY=false
EXTERNAL_EMAIL_DELIVERY=false
PRODUCTION_PROVIDER_ROUTING=false
MARKETING_DELIVERY=false

# Dedicated Keycloak password-recovery stream. Keep both false until the
# SECURITY-only SMTP credential, verified sender, Postal API, tenant policy,
# private STARTTLS path, and staging test evidence have been approved.
KLYROW_SECURITY_SMTP_ENABLED=false
KLYROW_SECURITY_SMTP_LIVE_ENABLED=false
KLYROW_PROVIDER_LIVE_DELIVERY_ENABLED=false
KLYROW_OUTBOUND_IP=37.27.128.39
KLYROW_EXPECTED_PTR=mail.klyrow.com
KLYROW_RELEASE_SHA=

BEYVRA_EMAIL_TENANT_ID=
BEYVRA_EMAIL_SERVICE_TOKEN_FILE=/run/secrets/beyvra_email_service_token
KLYROW_PRODUCTION_GATE_APPROVED=false
KLYROW_CANARY_ALLOWED_DOMAIN=
KLYROW_CANARY_ALLOWED_SENDER=
KLYROW_CANARY_ALLOWED_RECIPIENT=
KLYROW_CANARY_MAX_DELIVERIES=0
KLYROW_AI_ENABLED=false
KLYROW_POSTAL_API_URL=http://postal-web:5000
KLYROW_POSTAL_API_KEY=CHANGE_AFTER_POSTAL_BOOTSTRAP
KLYROW_POSTAL_SERVER_KEY=CHANGE_AFTER_POSTAL_BOOTSTRAP
KLYROW_POSTAL_WEBHOOK_PUBLIC_KEY=/run/klyrow/postal-webhook-signing-public.pem
KLYROW_POSTAL_TENANT_ID=CHANGE_AFTER_BOOTSTRAP
KLYROW_RATE_PER_MINUTE=60
KLYROW_DAILY_QUOTA=10000
POSTGRES_PASSWORD=CHANGE_ME
MAUTIC_DB_PASSWORD=CHANGE_ME
MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME
POSTAL_DB_PASSWORD=CHANGE_ME
POSTAL_RABBITMQ_PASSWORD=CHANGE_ME
POSTAL_SECRET_KEY=CHANGE_ME_128_HEX
POSTAL_SIGNING_KEY_PATH=/opt/postal/config/signing.key
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

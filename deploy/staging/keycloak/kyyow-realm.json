{
  "realm": "kyyow",
  "enabled": true,
  "displayName": "Kyyow Staging",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "clients": [
    {
      "clientId": "kyyow-portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://staging.klyrow.com/auth/callback"],
      "webOrigins": ["https://staging.klyrow.com"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://staging.klyrow.com/*"
      },
      "defaultClientScopes": ["openid", "profile", "email", "roles", "web-origins"]
    }
  ],
  "roles": {
    "realm": [
      {"name": "kyyow-admin"},
      {"name": "kyyow-supervisor"},
      {"name": "kyyow-agent"},
      {"name": "kyyow-auditor"}
    ]
  }
}

#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env

umask 077
archive="${1:?usage: scripts/restore ENCRYPTED_BACKUP.tar.gz.gpg}"
private_key="${KLYROW_BACKUP_PRIVATE_KEY_FILE:-}"
staging_root="${KLYROW_BACKUP_STAGING_ROOT:-/dev/shm}"

[[ -f "$archive" && -f "$archive.sha256" ]] || { echo "Encrypted backup or checksum missing" >&2; exit 1; }
(cd "$(dirname "$archive")" && sha256sum -c "$(basename "$archive").sha256")
[[ "${CONFIRM_RESTORE:-}" == "RESTORE_KLYROW" ]] || { echo "Set CONFIRM_RESTORE=RESTORE_KLYROW; restore overwrites Klyrow/Postal/Mautic data and RabbitMQ definitions" >&2; exit 2; }
[[ "$(stat -f -c %T "$staging_root")" == "tmpfs" ]] || { echo "Restore staging must be tmpfs" >&2; exit 2; }
stage="$(mktemp -d "$staging_root/klyrow-restore.XXXXXX")"
[[ "$stage" == "$staging_root"/klyrow-restore.* ]] || { echo "Unsafe restore staging path" >&2; exit 2; }
cleanup(){ find "$stage" -type f -exec shred -u {} + 2>/dev/null || true; rm -rf -- "$stage"; }
trap cleanup EXIT

gpg_home="${KLYROW_BACKUP_GNUPGHOME:-$stage/gnupg}"
if [[ "$gpg_home" == "$stage/gnupg" ]]; then
  [[ -r "$private_key" ]] || { echo "Backup private key unavailable" >&2; exit 2; }
  install -d -m 0700 "$gpg_home"
  gpg --batch --homedir "$gpg_home" --import "$private_key" >/dev/null 2>&1
fi
gpg --batch --homedir "$gpg_home" --decrypt "$archive" | tar -xz -C "$stage"
(cd "$stage" && sha256sum -c MANIFEST.sha256)

docker compose exec -T postgres pg_restore -U klyrow --clean --if-exists -d klyrow <"$stage/klyrow.dump"
gzip -dc "$stage/mautic.sql.gz" | docker compose exec -T mautic-db sh -lc 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$MARIADB_DATABASE"'
gzip -dc "$stage/postal.sql.gz" | docker compose exec -T postal-db sh -lc 'MYSQL_PWD="$MARIADB_ROOT_PASSWORD" exec mariadb -uroot "$MARIADB_DATABASE"'
docker compose exec -T mautic tar -xz -C /var/www/html <"$stage/mautic-files.tar.gz"
docker compose exec -T rabbitmq rabbitmqctl -q import_definitions - <"$stage/rabbitmq-definitions.json"
printf 'Klyrow databases, Mautic files, and RabbitMQ definitions restored from encrypted backup; configuration was not overwritten.\n'

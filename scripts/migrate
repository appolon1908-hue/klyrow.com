#!/usr/bin/env python3
"""Apply ordered SQL migrations exactly once under a PostgreSQL advisory lock."""
import hashlib
import os
import re
from pathlib import Path

from psycopg import sql as psycopg_sql
from sqlalchemy import create_engine, text
from sqlalchemy.engine import make_url


root = Path(__file__).resolve().parents[1]
database_url = os.environ["KLYROW_DATABASE_URL"]
if not database_url.startswith(("postgresql://", "postgresql+psycopg://")):
    raise SystemExit("production migrations require PostgreSQL")
owner_password_file = Path(os.environ["KLYROW_DATABASE_OWNER_PASSWORD_FILE"])
runtime_password_file = Path(os.environ["KLYROW_DATABASE_RUNTIME_PASSWORD_FILE"])
for path in (owner_password_file, runtime_password_file):
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        raise SystemExit("database password files must be absolute regular files")
owner_password = owner_password_file.read_text(encoding="utf-8").strip()
runtime_password = runtime_password_file.read_text(encoding="utf-8").strip()
if not owner_password or not runtime_password or len(owner_password) > 1024 or len(runtime_password) > 1024:
    raise SystemExit("database password file is empty or oversized")

engine = create_engine(make_url(database_url).set(password=owner_password), pool_pre_ping=True)
files = sorted((root / "migrations").glob("*.sql"))
with engine.begin() as connection:
    connection.execute(text("SELECT pg_advisory_xact_lock(1263294032)"))
    connection.execute(text("""
        CREATE TABLE IF NOT EXISTS klyrow_schema_migrations (
            version text PRIMARY KEY,
            sha256 text NOT NULL,
            applied_at timestamptz NOT NULL DEFAULT now()
        )
    """))
    applied = dict(connection.execute(text("SELECT version, sha256 FROM klyrow_schema_migrations")).tuples().all())
    for path in files:
        payload = path.read_bytes()
        digest = hashlib.sha256(payload).hexdigest()
        if path.name in applied:
            if applied[path.name] != digest:
                raise SystemExit(f"applied migration checksum mismatch: {path.name}")
            continue
        sql = payload.decode("utf-8")
        # Migration files are also directly runnable with psql. The runner owns
        # the transaction so embedded wrappers are removed, and psycopg literal
        # percent signs are escaped before using its native multi-statement path.
        sql = re.sub(r"\A\s*BEGIN\s*;", "", sql, flags=re.IGNORECASE)
        sql = re.sub(r"COMMIT\s*;(?=\s*(?:--[^\n]*\n?)*\Z)", "", sql, flags=re.IGNORECASE)
        connection.exec_driver_sql(sql.replace("%", "%%"))
        connection.execute(
            text("INSERT INTO klyrow_schema_migrations(version, sha256) VALUES (:version, :sha256)"),
            {"version": path.name, "sha256": digest},
        )
        print(f"applied {path.name} {digest}")
    # The password is supplied through a root-owned secret file and bound with
    # psycopg's SQL literal adapter; it is never interpolated or logged.
    cursor = connection.connection.driver_connection.cursor()
    cursor.execute(psycopg_sql.SQL("ALTER ROLE {} LOGIN PASSWORD {}").format(
        psycopg_sql.Identifier("klyrow_runtime"), psycopg_sql.Literal(runtime_password)
    ))

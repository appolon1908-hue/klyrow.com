#!/usr/bin/env python3
"""Move legacy Klyrow credentials to files and reconcile transport authority."""
from __future__ import annotations

import os
import secrets
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from apps.gateway.app.durable_keys import KEYRING_ENV, load_keyring, new_keyring_document


CANONICAL_MIDDLEWARE_URL = (
    "https://middleware-email-events.internal.codestra.agency:18080"
)
LEGACY_PLAINTEXT_MIDDLEWARE_URLS = frozenset(
    {
        "http://10.40.0.1:8095",
        "http://10.40.0.1:18080",
    }
)


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def create_secret_file(target: Path, value: str) -> None:
    """Publish a complete private file atomically without overwriting authority."""
    descriptor, temporary_name = tempfile.mkstemp(prefix=".credential-migrating-", dir=target.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            stream.write(value)
            stream.flush()
            os.fsync(stream.fileno())
        os.chown(temporary, 0, 0)
        os.chmod(temporary, 0o600)
        # Atomic creation with no replacement, even if another migration won.
        try:
            os.link(temporary, target)
        except FileExistsError:
            fail("Runtime credential appeared during migration; retry after verifying authority.")
        directory = os.open(target.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        temporary.unlink(missing_ok=True)


def reconcile_middleware_url(raw: str) -> str:
    """Upgrade known plaintext authority and reject unknown insecure overrides."""

    value = raw.strip().rstrip("/")
    if not value or value in LEGACY_PLAINTEXT_MIDDLEWARE_URLS:
        return CANONICAL_MIDDLEWARE_URL

    parsed = urlsplit(value)
    if (
        parsed.scheme != "https"
        or not parsed.hostname
        or parsed.username is not None
        or parsed.password is not None
        or parsed.query
        or parsed.fragment
    ):
        fail(
            "Refusing unknown or insecure KLYROW_MIDDLEWARE_URL; "
            "review the mTLS transport authority explicitly."
        )
    return value


def main() -> None:
    if os.geteuid() != 0:
        fail("Run with sudo so migrated runtime credentials remain root-owned.")

    root = Path(__file__).resolve().parents[1]
    env_path = root / ".env"
    if not env_path.is_file():
        fail("Missing .env; run scripts/generate-env first.")

    secret_dir = Path(
        os.environ.get("KLYROW_RUNTIME_SECRET_DIR", "/etc/klyrow/secrets")
    )
    secret_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chown(secret_dir, 0, 0)
    os.chmod(secret_dir, 0o700)

    lines = env_path.read_text(encoding="utf-8").splitlines()
    values: dict[str, str] = {}
    for line in lines:
        if line and not line.lstrip().startswith("#") and "=" in line:
            name, value = line.split("=", 1)
            values[name] = value

    middleware_url = reconcile_middleware_url(
        values.get("KLYROW_MIDDLEWARE_URL", "")
    )

    specs = {
        "KLYROW_SESSION_SECRET": (
            "KLYROW_SESSION_SECRET_FILE",
            "session-secret",
            True,
        ),
        "KLYROW_POSTAL_API_KEY": (
            "KLYROW_POSTAL_API_KEY_FILE",
            "postal-api-key",
            False,
        ),
        "KLYROW_METRICS_TOKEN": (
            "KLYROW_METRICS_TOKEN_FILE",
            "metrics-token",
            True,
        ),
        "KLYROW_MIDDLEWARE_API_KEY": (
            "KLYROW_MIDDLEWARE_API_KEY_FILE",
            "middleware-api-key",
            False,
        ),
        "KLYROW_MAUTIC_API_CLIENT_ID": (
            "KLYROW_MAUTIC_API_CLIENT_ID_FILE",
            "mautic-api-client-id",
            False,
        ),
        "KLYROW_MAUTIC_API_CLIENT_SECRET": (
            "KLYROW_MAUTIC_API_CLIENT_SECRET_FILE",
            "mautic-api-client-secret",
            False,
        ),
        "KLYROW_WEBHOOK_SECRET": (
            "KLYROW_WEBHOOK_SECRET_FILE",
            "webhook-secret",
            False,
        ),
        "POSTGRES_PASSWORD": ("KLYROW_DATABASE_OWNER_PASSWORD_FILE", "database-owner-password", False),
        "KLYROW_DATABASE_RUNTIME_PASSWORD": (
            "KLYROW_DATABASE_RUNTIME_PASSWORD_FILE",
            "database-runtime-password",
            True,
        ),
    }
    replacement: dict[str, str] = {}
    removed = set(specs)
    for legacy_name, (file_name, basename, generate) in specs.items():
        configured_path = values.get(file_name, "").strip()
        target = Path(configured_path) if configured_path else secret_dir / basename
        if target.is_symlink() or (target.exists() and not target.is_file()):
            fail(f"Refusing non-regular runtime credential file for {file_name}.")
        if configured_path and (not target.is_absolute() or not target.is_file()):
            fail(f"Configured {file_name} must reference an existing absolute file.")
        if not target.exists():
            value = values.get(legacy_name, "")
            if not value and generate:
                value = secrets.token_hex(32)
            create_secret_file(target, value)
        elif target.stat().st_size == 0 and values.get(legacy_name, ""):
            fail(f"Empty {file_name} conflicts with a legacy credential; restore the approved file before retrying.")
        os.chown(target, 0, 0)
        os.chmod(target, 0o600)
        replacement[file_name] = str(target)

    configured_keyring = values.get(KEYRING_ENV, "").strip()
    keyring_path = Path(configured_keyring) if configured_keyring else secret_dir / "durable-result-keyring.json"
    if configured_keyring and (not keyring_path.is_absolute() or not keyring_path.is_file()):
        fail("Configured durable-result keyring must be an existing absolute file.")
    if keyring_path.is_symlink() or (keyring_path.exists() and not keyring_path.is_file()):
        fail("Refusing non-regular durable-result keyring.")
    if not keyring_path.exists():
        create_secret_file(keyring_path, new_keyring_document())
    try:
        load_keyring(keyring_path)
    except ValueError:
        fail("Durable-result keyring is invalid; preserve and repair the approved authority.")
    os.chown(keyring_path, 0, 0)
    os.chmod(keyring_path, 0o600)
    replacement[KEYRING_ENV] = str(keyring_path)

    output: list[str] = []
    seen: set[str] = set()
    middleware_url_seen = False
    for line in lines:
        name = line.split("=", 1)[0] if "=" in line else ""
        if name in removed:
            continue
        if name == "KLYROW_MIDDLEWARE_URL":
            if not middleware_url_seen:
                output.append(f"KLYROW_MIDDLEWARE_URL={middleware_url}")
                middleware_url_seen = True
            continue
        if name == "KLYROW_DATABASE_URL":
            output.append("KLYROW_DATABASE_URL=postgresql+psycopg://klyrow_runtime@postgres:5432/klyrow")
            continue
        if name in replacement:
            output.append(f"{name}={replacement[name]}")
            seen.add(name)
        else:
            output.append(line)
    for name, value in replacement.items():
        if name not in seen:
            output.append(f"{name}={value}")
    if not middleware_url_seen:
        output.append(f"KLYROW_MIDDLEWARE_URL={middleware_url}")
    if not any(
        line.startswith("KLYROW_DATABASE_PASSWORD_FILE=") for line in output
    ):
        output.append(
            f"KLYROW_DATABASE_PASSWORD_FILE="
            f"{secret_dir / 'database-runtime-password'}"
        )

    temporary = env_path.with_suffix(".env.migrating")
    temporary.write_text("\n".join(output) + "\n", encoding="utf-8")
    os.chown(temporary, 0, 0)
    os.chmod(temporary, 0o600)
    temporary.replace(env_path)
    print(
        "Klyrow runtime credentials and mTLS middleware authority reconciled; "
        "values were not displayed."
    )


if __name__ == "__main__":
    main()

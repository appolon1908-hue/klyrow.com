#!/usr/bin/env python3
"""Move legacy Klyrow environment credentials into root-owned files."""
from __future__ import annotations

import os
import secrets
import shutil
import sys
from pathlib import Path


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


if os.geteuid() != 0:
    fail("Run with sudo so migrated runtime credentials remain root-owned.")

root = Path(__file__).resolve().parents[1]
env_path = root / ".env"
if not env_path.is_file():
    fail("Missing .env; run scripts/generate-env first.")

secret_dir = Path(os.environ.get("KLYROW_RUNTIME_SECRET_DIR", "/etc/klyrow/secrets"))
secret_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chown(secret_dir, 0, 0)
os.chmod(secret_dir, 0o700)
config_dir = Path(os.environ.get("KLYROW_RUNTIME_CONFIG_DIR", "/etc/klyrow"))
credential_dir = config_dir / "postal-credentials"
credential_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
os.chown(credential_dir, 0, 10001)
os.chmod(credential_dir, 0o750)
seed_secret_dir = config_dir / "seed-secrets"
seed_secret_dir.mkdir(mode=0o750, parents=True, exist_ok=True)
os.chown(seed_secret_dir, 0, 10001)
os.chmod(seed_secret_dir, 0o750)
transport_registry = config_dir / "postal-transports.json"
if not transport_registry.exists():
    shutil.copyfile(root / "config/postal/transports.example.json", transport_registry)
os.chown(transport_registry, 0, 10001)
os.chmod(transport_registry, 0o640)
beyvra_key = credential_dir / "beyvra-api-key"
if not beyvra_key.exists():
    beyvra_key.touch(mode=0o600)
os.chown(beyvra_key, 0, 10001)
os.chmod(beyvra_key, 0o640)
beyvra_public_key = credential_dir / "beyvra-signing-public.pem"
if not beyvra_public_key.exists():
    beyvra_public_key.touch(mode=0o600)
os.chown(beyvra_public_key, 0, 10001)
os.chmod(beyvra_public_key, 0o640)

lines = env_path.read_text(encoding="utf-8").splitlines()
values: dict[str, str] = {}
for line in lines:
    if line and not line.lstrip().startswith("#") and "=" in line:
        name, value = line.split("=", 1)
        values[name] = value

specs = {
    "KLYROW_SESSION_SECRET": ("KLYROW_SESSION_SECRET_FILE", "session-secret", True),
    "KLYROW_POSTAL_API_KEY": ("KLYROW_POSTAL_API_KEY_FILE", "postal-api-key", False),
    "KLYROW_METRICS_TOKEN": ("KLYROW_METRICS_TOKEN_FILE", "metrics-token", True),
}
replacement: dict[str, str] = {}
removed = set(specs)
for legacy_name, (file_name, basename, generate) in specs.items():
    target = secret_dir / basename
    if not target.exists():
        value = values.get(legacy_name, "")
        if not value and generate:
            value = secrets.token_hex(32)
        target.touch(mode=0o600, exist_ok=False)
        target.write_text(value, encoding="utf-8")
    os.chown(target, 0, 0)
    os.chmod(target, 0o600)
    replacement[file_name] = str(target)
replacement["KLYROW_POSTAL_TRANSPORTS_HOST_FILE"] = str(transport_registry)
replacement["KLYROW_POSTAL_CREDENTIALS_DIR"] = str(credential_dir)
replacement["KLYROW_SEED_SECRETS_DIR"] = str(seed_secret_dir)

output: list[str] = []
seen: set[str] = set()
for line in lines:
    name = line.split("=", 1)[0] if "=" in line else ""
    if name in removed:
        continue
    if name in replacement:
        output.append(f"{name}={replacement[name]}")
        seen.add(name)
    else:
        output.append(line)
for name, value in replacement.items():
    if name not in seen:
        output.append(f"{name}={value}")

temporary = env_path.with_suffix(".env.migrating")
temporary.write_text("\n".join(output) + "\n", encoding="utf-8")
os.chown(temporary, 0, 0)
os.chmod(temporary, 0o600)
temporary.replace(env_path)
print("Klyrow runtime credential files reconciled; values were not displayed.")

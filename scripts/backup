#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env

umask 077
recipient_file="${KLYROW_BACKUP_RECIPIENT_FILE:-/etc/klyrow/backup-recipient-public.asc}"
staging_root="${KLYROW_BACKUP_STAGING_ROOT:-/dev/shm}"
destination="${1:-backups}"
stamp="$(date -u +%Y%m%dT%H%M%SZ)"
archive="$destination/klyrow-$stamp.tar.gz.gpg"

[[ -r "$recipient_file" ]] || { echo "Backup recipient public key unavailable" >&2; exit 2; }
[[ "$(stat -f -c %T "$staging_root")" == "tmpfs" ]] || { echo "Backup staging must be tmpfs" >&2; exit 2; }
mkdir -p "$destination"
stage="$(mktemp -d "$staging_root/klyrow-backup.XXXXXX")"
[[ "$stage" == "$staging_root"/klyrow-backup.* ]] || { echo "Unsafe backup staging path" >&2; exit 2; }
cleanup(){ find "$stage" -type f -exec shred -u {} + 2>/dev/null || true; rm -rf -- "$stage"; }
trap cleanup EXIT

docker compose exec -T postgres pg_dump -U klyrow -Fc klyrow >"$stage/klyrow.dump"
docker compose exec -T mautic-db sh -lc 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb-dump -u"$MARIADB_USER" --single-transaction "$MARIADB_DATABASE"' | gzip >"$stage/mautic.sql.gz"
docker compose exec -T postal-db sh -lc 'MYSQL_PWD="$MARIADB_PASSWORD" exec mariadb-dump -u"$MARIADB_USER" --single-transaction --all-databases' | gzip >"$stage/postal.sql.gz"
(cd "$stage" && sha256sum klyrow.dump mautic.sql.gz postal.sql.gz >MANIFEST.sha256)

gpg_home="$stage/gnupg";install -d -m 0700 "$gpg_home"
gpg --batch --homedir "$gpg_home" --import "$recipient_file" >/dev/null 2>&1
recipient="$(gpg --batch --homedir "$gpg_home" --with-colons --list-keys | awk -F: '$1=="fpr"{print $10;exit}')"
[[ "$recipient" =~ ^[A-F0-9]{40,64}$ ]] || { echo "Backup recipient fingerprint invalid" >&2; exit 2; }

paths=(config docker docs scripts docker-compose.yml .env)
[[ -d secrets ]] && paths+=(secrets)
tar -cz -C "$stage" klyrow.dump mautic.sql.gz postal.sql.gz MANIFEST.sha256 -C "$ROOT" "${paths[@]}" |
  gpg --batch --yes --homedir "$gpg_home" --trust-model always --recipient "$recipient" --output "$archive" --encrypt
sha256sum "$archive" >"$archive.sha256"
chmod 0600 "$archive" "$archive.sha256"
printf '%s\n' "$archive"

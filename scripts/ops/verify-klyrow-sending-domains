#!/usr/bin/env python3
"""Read-only verification of Klyrow's expected sending-enabled domain inventory."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

from sqlalchemy import create_engine, text
from sqlalchemy.exc import SQLAlchemyError


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_MANIFEST = ROOT / "config/runtime/klyrow-sending-domains.json"


def load_manifest(path: Path) -> tuple[str, list[str]]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    required_state = str(payload.get("required_state") or "").strip().upper()
    rows = payload.get("domains")
    if required_state != "SENDING_ENABLED" or not isinstance(rows, list):
        raise ValueError("invalid domain inventory manifest")
    names = []
    for row in rows:
        if not isinstance(row, dict):
            raise ValueError("invalid domain inventory entry")
        name = str(row.get("name") or "").strip().lower().rstrip(".")
        if (
            not name
            or row.get("verified") is not True
            or row.get("sending_enabled") is not True
        ):
            raise ValueError("invalid domain inventory entry")
        names.append(name)
    if len(names) != len(set(names)):
        raise ValueError("duplicate domain inventory entry")
    return required_state, sorted(names)


def main() -> int:
    manifest_path = Path(
        os.getenv("KLYROW_SENDING_DOMAIN_INVENTORY_FILE", str(DEFAULT_MANIFEST))
    )
    database_url = os.getenv("KLYROW_DATABASE_URL", "").strip()
    if not database_url:
        print("KLYROW_DATABASE_URL is required", file=sys.stderr)
        return 2

    try:
        required_state, expected = load_manifest(manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(f"DOMAIN_INVENTORY_MANIFEST=ERROR:{type(exc).__name__}", file=sys.stderr)
        return 2

    engine = create_engine(database_url, pool_pre_ping=True)
    try:
        with engine.connect() as connection:
            rows = connection.execute(
                text(
                    """
                    SELECT lower(domain) AS domain, upper(state) AS state
                    FROM domain_claims
                    ORDER BY lower(domain)
                    """
                )
            ).mappings().all()
    except SQLAlchemyError as exc:
        print(f"DOMAIN_INVENTORY_DATABASE=ERROR:{type(exc).__name__}", file=sys.stderr)
        return 2

    actual = {str(row["domain"]): str(row["state"]) for row in rows}
    expected_set = set(expected)
    sending_enabled = {
        domain for domain, state in actual.items() if state == required_state
    }

    missing = sorted(domain for domain in expected if domain not in actual)
    wrong_state = sorted(
        {
            domain: actual[domain]
            for domain in expected
            if domain in actual and actual[domain] != required_state
        }.items()
    )
    unexpected = sorted(sending_enabled - expected_set)

    result = {
        "expected_count": len(expected),
        "sending_enabled_count": len(sending_enabled),
        "missing": missing,
        "wrong_state": [
            {"domain": domain, "state": state} for domain, state in wrong_state
        ],
        "unexpected_sending_enabled": unexpected,
        "status": (
            "PASS"
            if not missing and not wrong_state and not unexpected
            else "FAIL"
        ),
    }
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

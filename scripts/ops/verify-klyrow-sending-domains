#!/usr/bin/env python3
"""Read-only verification of Klyrow's expected sending-enabled domains."""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

from sqlalchemy import create_engine, text
from sqlalchemy.exc import SQLAlchemyError


ROOT = Path(__file__).resolve().parents[2]
DEFAULT_MANIFEST = (
    ROOT / "evidence/runtime/verified-sending-domains-20260827.json"
)


def load_manifest(path: Path) -> list[str]:
    payload = json.loads(path.read_text(encoding="utf-8"))
    rows = payload.get("domains")
    if (
        payload.get("status") != "VERIFIED_SENDING_ENABLED"
        or payload.get("authorization_effect") != "NONE"
        or not isinstance(rows, list)
    ):
        raise ValueError("invalid domain inventory manifest")
    names = [
        str(value).strip().lower().rstrip(".")
        for value in rows
        if str(value).strip()
    ]
    if len(names) != len(rows) or len(names) != len(set(names)):
        raise ValueError("invalid or duplicate domain inventory entry")
    return sorted(names)


def main() -> int:
    manifest_path = Path(
        os.getenv(
            "KLYROW_SENDING_DOMAIN_INVENTORY_FILE",
            str(DEFAULT_MANIFEST),
        )
    )
    database_url = os.getenv("KLYROW_DATABASE_URL", "").strip()
    if not database_url:
        print("KLYROW_DATABASE_URL is required", file=sys.stderr)
        return 2

    try:
        expected = load_manifest(manifest_path)
    except (OSError, ValueError, json.JSONDecodeError) as exc:
        print(
            f"DOMAIN_INVENTORY_MANIFEST=ERROR:{type(exc).__name__}",
            file=sys.stderr,
        )
        return 2

    engine = create_engine(database_url, pool_pre_ping=True)
    try:
        with engine.connect() as connection:
            rows = connection.execute(
                text(
                    """
                    SELECT lower(domain) AS domain, upper(state) AS state
                    FROM domain_claims
                    ORDER BY lower(domain)
                    """
                )
            ).mappings().all()
    except SQLAlchemyError as exc:
        print(
            f"DOMAIN_INVENTORY_DATABASE=ERROR:{type(exc).__name__}",
            file=sys.stderr,
        )
        return 2
    finally:
        engine.dispose()

    actual = {
        str(row["domain"]).lower().rstrip("."): str(row["state"]).upper()
        for row in rows
    }
    expected_set = set(expected)
    sending_enabled = {
        domain
        for domain, state in actual.items()
        if state == "SENDING_ENABLED"
    }

    missing = sorted(expected_set - actual.keys())
    wrong_state = sorted(
        (
            {"domain": domain, "state": actual[domain]}
            for domain in expected
            if domain in actual and actual[domain] != "SENDING_ENABLED"
        ),
        key=lambda value: value["domain"],
    )
    unexpected = sorted(sending_enabled - expected_set)

    result = {
        "expected_count": len(expected),
        "sending_enabled_count": len(sending_enabled),
        "missing": missing,
        "wrong_state": wrong_state,
        "unexpected_sending_enabled": unexpected,
        "status": (
            "PASS"
            if not missing and not wrong_state and not unexpected
            else "FAIL"
        ),
    }
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env
[[ "$EUID" -eq 0 ]] || { echo "Run deployment with sudo." >&2; exit 1; }
scripts/migrate-runtime-secrets
docker compose config --quiet
scripts/render-postal-config
docker compose pull
docker compose build gateway
scripts/migrate
docker compose up -d --remove-orphans
scripts/health

#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env
[[ "$EUID" -eq 0 ]] || { echo "Run deployment with sudo." >&2; exit 1; }
git diff --quiet && git diff --cached --quiet || { echo "Refusing deployment with uncommitted source drift" >&2; exit 1; }
export KLYROW_RELEASE_SHA="$(git rev-parse --verify HEAD)"
scripts/migrate-runtime-secrets
docker compose config --quiet
scripts/render-postal-config
docker compose pull
docker compose build gateway gateway-migrate
scripts/migrate
docker compose up -d --remove-orphans
scripts/health
install -d -o root -g root -m 0750 /var/lib/klyrow/releases
printf '%s\n' "$KLYROW_RELEASE_SHA" | install -o root -g root -m 0640 /dev/stdin /var/lib/klyrow/releases/current
echo "Deployed immutable release $KLYROW_RELEASE_SHA"

#!/usr/bin/env bash
set -Eeuo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"; cd "$root"
[[ "$EUID" -eq 0 ]] || {
  echo "Run this installer with sudo so runtime credentials are root-owned." >&2
  exit 1
}
[[ ! -e .env ]] || { echo ".env already exists; refusing to overwrite" >&2; exit 1; }
runtime_secret_dir="${KLYROW_RUNTIME_SECRET_DIR:-/etc/klyrow/secrets}"
admin_email="${KLYROW_ADMIN_EMAIL:-admin@klyrow.com}"
admin_password="${KLYROW_ADMIN_PASSWORD:-$(openssl rand -base64 24 | tr -d '\n')}"
cp .env.example .env
secret() { openssl rand -hex "$1"; }
install -d -o root -g root -m 0700 "$runtime_secret_dir"
umask 077
# Create dedicated result authority before configuring its path in .env.
# Preserve a valid preinstalled keyring; never silently replace a missing key
# during a later migrate-runtime-secrets run.
python3 - "$runtime_secret_dir/durable-result-keyring.json" <<'PY_KEYRING'
import runpy
import sys
from pathlib import Path

helpers = runpy.run_path("scripts/migrate-runtime-secrets")
path = Path(sys.argv[1])
if not path.is_absolute():
    raise SystemExit("Runtime keyring path must be absolute.")
if path.exists() or path.is_symlink():
    helpers["load_keyring"](path)
else:
    helpers["create_secret_file"](path, helpers["new_keyring_document"]())
PY_KEYRING
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/session-secret"
install -o root -g root -m 0600 /dev/null "$runtime_secret_dir/postal-api-key"
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/metrics-token"
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/middleware-api-key"
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/webhook-secret"
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/provider-credential-key"
secret 32 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/postal-provisioner-token"
openssl rand -base64 32 | tr '+/' '-_' | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/security-payload-key"
postgres_password="$(secret 24)"
printf '%s' "$postgres_password" | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/database-owner-password"
secret 24 | install -o root -g root -m 0600 /dev/stdin "$runtime_secret_dir/database-runtime-password"
sed -i \
  -e "s|KLYROW_SESSION_SECRET_FILE=.*|KLYROW_SESSION_SECRET_FILE=$runtime_secret_dir/session-secret|" \
  -e "s|KLYROW_DURABLE_RESULT_KEYRING_FILE=.*|KLYROW_DURABLE_RESULT_KEYRING_FILE=$runtime_secret_dir/durable-result-keyring.json|" \
  -e "s|KLYROW_POSTAL_API_KEY_FILE=.*|KLYROW_POSTAL_API_KEY_FILE=$runtime_secret_dir/postal-api-key|" \
  -e "s|KLYROW_METRICS_TOKEN_FILE=.*|KLYROW_METRICS_TOKEN_FILE=$runtime_secret_dir/metrics-token|" \
  -e "s|KLYROW_MIDDLEWARE_API_KEY_FILE=.*|KLYROW_MIDDLEWARE_API_KEY_FILE=$runtime_secret_dir/middleware-api-key|" \
  -e "s|KLYROW_WEBHOOK_SECRET_FILE=.*|KLYROW_WEBHOOK_SECRET_FILE=$runtime_secret_dir/webhook-secret|" \
  -e "s|KLYROW_PROVIDER_CREDENTIAL_KEY_FILE=.*|KLYROW_PROVIDER_CREDENTIAL_KEY_FILE=$runtime_secret_dir/provider-credential-key|" \
  -e "s|KLYROW_POSTAL_PROVISIONER_TOKEN_FILE=.*|KLYROW_POSTAL_PROVISIONER_TOKEN_FILE=$runtime_secret_dir/postal-provisioner-token|" \
  -e "s|KLYROW_SECURITY_PAYLOAD_KEY_FILE=.*|KLYROW_SECURITY_PAYLOAD_KEY_FILE=$runtime_secret_dir/security-payload-key|" \
  -e "s|KLYROW_DATABASE_OWNER_PASSWORD_FILE=.*|KLYROW_DATABASE_OWNER_PASSWORD_FILE=$runtime_secret_dir/database-owner-password|" \
  -e "s|KLYROW_DATABASE_RUNTIME_PASSWORD_FILE=.*|KLYROW_DATABASE_RUNTIME_PASSWORD_FILE=$runtime_secret_dir/database-runtime-password|" \
  -e "s|KLYROW_DATABASE_PASSWORD_FILE=.*|KLYROW_DATABASE_PASSWORD_FILE=$runtime_secret_dir/database-runtime-password|" \
  -e "s|KLYROW_ADMIN_EMAIL=admin@klyrow.com|KLYROW_ADMIN_EMAIL=$admin_email|" \
  -e "s|KLYROW_ADMIN_PASSWORD=CHANGE_ME_20_CHARS|KLYROW_ADMIN_PASSWORD=$admin_password|" \
  -e "s|MAUTIC_DB_PASSWORD=CHANGE_ME|MAUTIC_DB_PASSWORD=$(secret 24)|" \
  -e "s|MAUTIC_DB_ROOT_PASSWORD=CHANGE_ME|MAUTIC_DB_ROOT_PASSWORD=$(secret 24)|" \
  -e "s|POSTAL_DB_PASSWORD=CHANGE_ME|POSTAL_DB_PASSWORD=$(secret 24)|" \
  -e "s|POSTAL_RABBITMQ_PASSWORD=CHANGE_ME|POSTAL_RABBITMQ_PASSWORD=$(secret 24)|" \
  -e "s|POSTAL_SECRET_KEY=CHANGE_ME_128_HEX|POSTAL_SECRET_KEY=$(secret 64)|" \
  -e "s|GRAFANA_ADMIN_PASSWORD=CHANGE_ME|GRAFANA_ADMIN_PASSWORD=$(secret 24)|" .env
chmod 600 .env
chown root:root .env
echo "Generated .env and root-private runtime secret files."
echo "Store the initial admin credential through the approved password manager before deployment."

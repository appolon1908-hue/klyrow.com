#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env
[[ "$EUID" -eq 0 ]] || { echo "Run deployment with sudo." >&2; exit 1; }
scripts/migrate-runtime-secrets
[[ -e secrets/postal/postal.yml ]] || scripts/render-postal-config
COMPOSE=(docker compose -f docker-compose.yml -f deploy/docker-compose.middleware-mtls.yml -f deploy/docker-compose.security-mail.yml -f docker-compose.postal-provisioning.yml -f docker-compose.web.yml)
"${COMPOSE[@]}" config --quiet
scripts/validate-production-images "${COMPOSE[@]}"
scripts/verify-release-authority pre-pull "${COMPOSE[@]}"
"${COMPOSE[@]}" pull
scripts/verify-release-authority post-pull "${COMPOSE[@]}"
"${COMPOSE[@]}" up -d

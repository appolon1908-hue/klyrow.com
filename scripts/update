#!/usr/bin/env bash
source "$(dirname "$0")/lib.sh"; require_env
[[ "$EUID" -eq 0 ]] || { echo "Run update with sudo." >&2; exit 1; }
scripts/migrate-runtime-secrets
git diff --quiet && git diff --cached --quiet || { echo "Refusing update with local changes" >&2; exit 1; }
git pull --ff-only
COMPOSE=(docker compose -f docker-compose.yml -f deploy/docker-compose.security-mail.yml)
"${COMPOSE[@]}" config --quiet
"${COMPOSE[@]}" pull
"${COMPOSE[@]}" build gateway
scripts/migrate
"${COMPOSE[@]}" up -d --remove-orphans
scripts/health

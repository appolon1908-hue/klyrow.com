#!/usr/bin/env bash
set -Eeuo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="${1:-$ROOT/deploy/staging/staging.env}"
[[ -f "$ENV_FILE" ]] || { echo "Missing staging environment file: $ENV_FILE" >&2; exit 2; }
set -a; source "$ENV_FILE"; set +a

fail() { echo "staging-preflight: $*" >&2; exit 2; }
for name in KLYROW_GATEWAY_IMAGE KLYROW_WEB_IMAGE KLYROW_MIGRATE_IMAGE KLYROW_SEARCH_IMAGE KLYROW_CADDY_IMAGE KLYROW_POSTGRES_IMAGE KLYROW_PROMETHEUS_IMAGE KLYROW_GRAFANA_IMAGE; do
  value="${!name:-}"
  [[ "$value" =~ @sha256:[0-9a-f]{64}$ ]] || fail "$name must be pinned by sha256 digest"
done
for name in KLYROW_SOURCE_SHA KLYROW_MIDDLEWARE_SOURCE_SHA KLYROW_ODOO_SOURCE_SHA; do
  [[ "${!name:-}" =~ ^[0-9a-f]{40}$ ]] || fail "$name must be an exact 40-character commit SHA"
done
[[ "${KLYROW_MIDDLEWARE_MIGRATION:-}" = 0061 ]] || fail "Middleware migration 0061 is required"
[[ "${KLYROW_ODOO_ADDON:-}" = codestra_klyrow_observability ]] || fail "unexpected Odoo addon"
[[ "${KLYROW_KEYCLOAK_REALM:-}" = kyyow ]] || fail "the Kyyow realm must be selected"
[[ "${KLYROW_STAGING_SECRET_DIR:-}" = /* ]] || fail "secret directory must be absolute"
[[ -d "$KLYROW_STAGING_SECRET_DIR" ]] || fail "OpenBao-rendered secret directory is absent"
for file in database-owner-password database-runtime-password session-secret result-keyring.json metrics-token middleware-token search-key grafana-password; do
  path="$KLYROW_STAGING_SECRET_DIR/$file"
  [[ -f "$path" && ! -L "$path" ]] || fail "missing regular secret file: $file"
  mode="$(stat -c %a "$path")"
  [[ "$mode" = 400 || "$mode" = 440 || "$mode" = 600 || "$mode" = 640 ]] || fail "unsafe mode $mode on $file"
done
docker compose --env-file "$ENV_FILE" -f "$ROOT/deploy/staging/compose.yml" config --quiet
docker compose --env-file "$ENV_FILE" -f "$ROOT/deploy/staging/compose.yml" config | grep -Eq 'published: "?(80|443)"?$' || fail "edge ports missing"
if docker compose --env-file "$ENV_FILE" -f "$ROOT/deploy/staging/compose.yml" config | grep -Eq 'published: "?(3000|7700|9090)"?$'; then
  fail "native monitoring/search port is published"
fi
echo "STAGING_PREFLIGHT=PASS"

[Unit]
Description=Klyrow production email platform
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/klyrow.com
ExecStart=/usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.security-mail.yml up -d
ExecStop=/usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.security-mail.yml stop
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target

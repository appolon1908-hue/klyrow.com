[Unit]
Description=Klyrow production email platform
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/klyrow.com
ExecStart=/root/klyrow.com/scripts/start
ExecStop=/root/klyrow.com/scripts/stop
TimeoutStartSec=900
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
